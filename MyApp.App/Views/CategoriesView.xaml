<UserControl x:Class="MyApp.App.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:MyApp.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
    </UserControl.Resources>
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,10">
            <TextBlock Text="Categories" FontSize="24" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
            <TextBlock Text="Finance" FontSize="14" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,0,20,10" HorizontalAlignment="Right">
            <Button Content="Add" Command="{Binding AddCategoryCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Edit" Command="{Binding EditCategoryCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Deactivate" Command="{Binding DeactivateCategoryCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Delete" Command="{Binding DeleteCategoryCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Refresh" Command="{Binding LoadCategoriesCommand}" Width="80"/>
        </StackPanel>

        <!-- Categories Grid -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Income Categories -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="INCOME CATEGORIES" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding IncomeCategories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Background="#1E1E1E"
                          Foreground="#E0E0E0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#3E3E42"
                          HeadersVisibility="Column"
                          Height="300"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#252526">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Parent" Binding="{Binding Parent.Name}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Expense Categories -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="EXPENSE CATEGORIES" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding ExpenseCategories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Background="#1E1E1E"
                          Foreground="#E0E0E0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#3E3E42"
                          HeadersVisibility="Column"
                          Height="300"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#252526">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Parent" Binding="{Binding Parent.Name}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>