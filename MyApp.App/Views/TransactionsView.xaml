<UserControl x:Class="MyApp.App.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,10">
            <TextBlock Text="Transactions" FontSize="24" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
            <TextBlock Text="Finance" FontSize="14" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,10">
            <Button Content="Add Income" Command="{Binding AddIncomeCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Add Expense" Command="{Binding AddExpenseCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Add Transfer" Command="{Binding AddTransferCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Edit" Command="{Binding EditTransactionCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Delete" Command="{Binding DeleteTransactionCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="80"/>
        </WrapPanel>

        <!-- Filters -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Margin="20,0,20,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: From Date, To Date, Account, Type -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="From Date:" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Margin="0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="To Date:" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Margin="0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="Account:" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding Accounts}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding FilterAccountId}"
                              Margin="0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Text="Type:" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding TransactionTypes}"
                              SelectedItem="{Binding FilterTransactionType}"
                              Margin="0"/>
                </StackPanel>

                <!-- Row 2: Category, Search, Buttons -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Category:" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding FilterCategoryId}"
                              Margin="0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Search Description:" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding SearchDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Content="Search / Apply Filter" Command="{Binding ApplyFilterCommand}" Margin="0" Padding="10,5"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="6" VerticalAlignment="Bottom">
                    <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Margin="0" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transactions DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Transactions}" 
                  SelectedItem="{Binding SelectedTransaction}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Background="#1E1E1E"
                  Foreground="#E0E0E0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3E3E42"
                  HeadersVisibility="Column"
                  Margin="20,0,20,20"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#252526">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3D3D3D"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.Resources>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="80"/>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay}" Width="160"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="120"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>