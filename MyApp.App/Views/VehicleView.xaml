<UserControl x:Class="MyApp.App.VehicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MyApp.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>

        <!-- Details panel card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15,12"/>
        </Style>

        <Style x:Key="DetailsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DetailsValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Shown while no vehicle is selected -->
        <Style x:Key="NoSelectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedVehicle}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Details values are hidden while no vehicle is selected -->
        <Style x:Key="DetailsGridStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedVehicle}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shown when the selected vehicle has no maintenance records yet -->
        <Style x:Key="NoMaintenanceStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedVehicle.MaintenanceRecordCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,10">
            <TextBlock Text="Vehicle" FontSize="24" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
            <TextBlock Text="Car" FontSize="14" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,0,20,10" HorizontalAlignment="Right">
            <Button Content="Add Vehicle" Command="{Binding AddVehicleCommand}" Width="110" Margin="0,0,10,0"/>
            <Button Content="Edit" Command="{Binding EditVehicleCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Deactivate" Command="{Binding DeactivateVehicleCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Refresh" Command="{Binding LoadVehiclesCommand}" Width="80"/>
        </StackPanel>

        <!-- Vehicle list -->
        <DataGrid Grid.Row="1"
                  x:Name="VehicleGrid"
                  ItemsSource="{Binding Vehicles}"
                  SelectedItem="{Binding SelectedVehicle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Background="#1E1E1E"
                  Foreground="#E0E0E0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3E3E42"
                  HeadersVisibility="Column"
                  Margin="20,0,20,10"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#252526">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3D3D3D"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Make" Binding="{Binding Vehicle.Make}" Width="*"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Vehicle.Model}" Width="*"/>
                <DataGridTextColumn Header="Year" Binding="{Binding Vehicle.Year, TargetNullValue='-'}" Width="60"/>
                <DataGridTextColumn Header="Registration No" Binding="{Binding Vehicle.RegistrationNo, TargetNullValue='-'}" Width="120"/>
                <DataGridTextColumn Header="Current Mileage (km)" Binding="{Binding Vehicle.CurrentMileage, StringFormat={}{0:N0}}" Width="130"/>
                <DataGridTextColumn Header="Purchase Date" Binding="{Binding Vehicle.PurchaseDate, StringFormat=dd/MM/yyyy, TargetNullValue='-'}" Width="105"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Vehicle.Notes, TargetNullValue='-'}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Vehicle.IsActive, Converter={StaticResource BoolToStatusConverter}}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selected vehicle details -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="20,0,20,20">
            <StackPanel>
                <TextBlock Text="Vehicle Details" FontSize="15" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,10"/>

                <TextBlock Text="Select a vehicle to see its details" Style="{StaticResource NoSelectionStyle}"/>

                <Grid Style="{StaticResource DetailsGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Vehicle -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Vehicle:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedVehicle.VehicleName}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Year:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVehicle.Vehicle.Year, TargetNullValue='-'}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Registration Number:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVehicle.Vehicle.RegistrationNo, TargetNullValue='-'}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Mileage:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVehicle.Vehicle.CurrentMileage, StringFormat={}{0:N0} km}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Purchase Date:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVehicle.Vehicle.PurchaseDate, StringFormat=dd/MM/yyyy, TargetNullValue='-'}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Notes:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedVehicle.Vehicle.Notes, TargetNullValue='-'}" Style="{StaticResource DetailsValueStyle}"/>

                    <!-- Maintenance figures calculated from MaintenanceRecord -->
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Total Maintenance Cost:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding SelectedVehicle.TotalMaintenanceCost, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Last Maintenance Date:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding SelectedVehicle.LastMaintenanceDate, StringFormat=dd/MM/yyyy, TargetNullValue='-'}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Last Maintenance Mileage:" Style="{StaticResource DetailsLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding SelectedVehicle.LastMaintenanceMileage, StringFormat={}{0:N0} km, TargetNullValue='-'}" Style="{StaticResource DetailsValueStyle}"/>

                    <TextBlock Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                               Text="No maintenance records yet"
                               Style="{StaticResource NoMaintenanceStyle}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
