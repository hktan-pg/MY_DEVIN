<UserControl x:Class="MyApp.App.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:converters="clr-namespace:MyApp.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>

        <!-- Card container -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15,12"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Net cash flow is green when positive and red when negative -->
        <Style x:Key="NetCashFlowValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNetCashFlowNegative}" Value="True">
                    <Setter Property="Foreground" Value="#E57373"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyMessageStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- "No upcoming reminders" -->
        <Style x:Key="RemindersEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource EmptyMessageStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasUpcomingReminders}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemindersListStyle" TargetType="ItemsControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasUpcomingReminders}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "No transactions recorded yet" -->
        <Style x:Key="TransactionsEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource EmptyMessageStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRecentTransactions}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "No vehicle information" -->
        <Style x:Key="VehicleEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource EmptyMessageStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasVehicle}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VehicleDetailsStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasVehicle}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Overdue reminder alert; only shown while something is overdue -->
        <Style x:Key="OverdueAlertStyle" TargetType="Border">
            <Setter Property="Background" Value="#3A2626"/>
            <Setter Property="BorderBrush" Value="#E57373"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOverdueReminders}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A reminder row behaves like a link that opens the Reminders screen -->
        <Style x:Key="ReminderLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="Open the Reminders screen"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="rowBorder" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#4D4D4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,20,20,20">
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MyApp Dashboard" FontSize="24" FontWeight="Bold" Foreground="#E0E0E0" Margin="0"/>
                        <TextBlock Text="{Binding TodayDisplay}" FontSize="14" Foreground="#B0B0B0" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Width="90" VerticalAlignment="Center"/>
                </Grid>

                <!-- Overdue reminders, shown prominently above everything else -->
                <Border Style="{StaticResource OverdueAlertStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="OVERDUE REMINDERS" FontSize="15" FontWeight="Bold"
                                       Foreground="#E57373" Margin="0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding OverdueSummaryText}" FontSize="12"
                                       Foreground="#FFCDD2" Margin="0" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding OverdueReminders}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ReminderLinkButtonStyle}"
                                            Command="{Binding DataContext.OpenRemindersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ReminderDate, StringFormat=dd/MM/yyyy}"
                                                       FontSize="12" Foreground="#E57373" Margin="0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       FontSize="13" Foreground="#FFCDD2"
                                                       TextTrimming="CharacterEllipsis" Margin="0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Summary cards -->
                <UniformGrid Columns="4" Margin="0,18,0,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Total Account Balance" Style="{StaticResource CardCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalAccountBalance, Converter={StaticResource CurrencyConverter}}"
                                       Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Current Month Income" Style="{StaticResource CardCaptionStyle}"/>
                            <TextBlock Text="{Binding CurrentMonthIncome, Converter={StaticResource CurrencyConverter}}"
                                       Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Current Month Expenses" Style="{StaticResource CardCaptionStyle}"/>
                            <TextBlock Text="{Binding CurrentMonthExpenses, Converter={StaticResource CurrencyConverter}}"
                                       Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Net Cash Flow (This Month)" Style="{StaticResource CardCaptionStyle}"/>
                            <TextBlock Text="{Binding NetCashFlow, Converter={StaticResource CurrencyConverter}}"
                                       Style="{StaticResource NetCashFlowValueStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Recent transactions + side panels -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent transactions -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recent Transactions" Style="{StaticResource SectionTitleStyle}"/>

                            <DataGrid ItemsSource="{Binding RecentTransactions}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      MaxHeight="175"
                                      Background="#1E1E1E"
                                      Foreground="#E0E0E0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#3E3E42"
                                      HeadersVisibility="Column"
                                      RowBackground="#1E1E1E"
                                      AlternatingRowBackground="#252526"
                                      BorderThickness="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#2D2D2D"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#3D3D3D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="80"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="120"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No transactions recorded yet" Style="{StaticResource TransactionsEmptyStyle}" Margin="0,5,0,0"/>

                            <Button Content="View All Transactions"
                                    Command="{Binding ViewAllTransactionsCommand}"
                                    Width="160"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Upcoming reminders + vehicle summary -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Upcoming Reminders" Style="{StaticResource SectionTitleStyle}"/>

                                <ItemsControl ItemsSource="{Binding UpcomingReminders}"
                                              Style="{StaticResource RemindersListStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ReminderLinkButtonStyle}"
                                                    Command="{Binding DataContext.OpenRemindersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ReminderDate, StringFormat=dd/MM/yyyy}"
                                                               FontSize="12" Foreground="#B0B0B0" Margin="0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               FontSize="13" Foreground="#E0E0E0"
                                                               TextTrimming="CharacterEllipsis" Margin="0"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No upcoming reminders" Style="{StaticResource RemindersEmptyStyle}" Margin="0"/>

                                <Button Content="View All Reminders"
                                        Command="{Binding OpenRemindersCommand}"
                                        Width="160"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Vehicle Summary" Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource VehicleDetailsStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Vehicle" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Vehicle.VehicleName}" FontSize="13" Foreground="#E0E0E0" Margin="0,0,0,3"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Registration No" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Vehicle.RegistrationNo, TargetNullValue='-'}" FontSize="13" Foreground="#E0E0E0" Margin="0,0,0,3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Current Mileage" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vehicle.CurrentMileage, StringFormat={}{0:N0} km}" FontSize="13" Foreground="#E0E0E0" Margin="0,0,0,3"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Maintenance" FontSize="12" Foreground="#B0B0B0" Margin="0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Vehicle.LastMaintenanceDate, StringFormat=dd/MM/yyyy, TargetNullValue='No record'}" FontSize="13" Foreground="#E0E0E0" Margin="0"/>
                                </Grid>

                                <TextBlock Text="No vehicle information" Style="{StaticResource VehicleEmptyStyle}" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Monthly expense chart -->
                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Monthly Expenses (Last 6 Months)" Style="{StaticResource SectionTitleStyle}"/>

                        <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="4">
                            <oxy:PlotView Model="{Binding ExpenseChart}" Height="200" Background="Transparent"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
