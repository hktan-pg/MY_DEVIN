<Window x:Class="MyApp.App.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Account" Height="400" Width="500"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Name:" FontWeight="Bold"/>
                <TextBox x:Name="NameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Account Type:" FontWeight="Bold"/>
                <ComboBox x:Name="AccountTypeComboBox" 
                          SelectedValue="{Binding AccountType}" 
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Bank"/>
                    <ComboBoxItem Content="Cash"/>
                    <ComboBoxItem Content="CreditCard"/>
                    <ComboBoxItem Content="FixedDeposit"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock Text="Account Number:" FontWeight="Bold"/>
                <TextBox x:Name="AccountNumberTextBox" Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Opening Balance:" FontWeight="Bold"/>
                <TextBox x:Name="OpeningBalanceTextBox" 
                         PreviewTextInput="OpeningBalanceTextBox_PreviewTextInput"/>

                <TextBlock Text="Notes:" FontWeight="Bold"/>
                <TextBox x:Name="NotesTextBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                <CheckBox x:Name="IsActiveCheckBox" IsChecked="{Binding IsActive}" Content="Active"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="80" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>