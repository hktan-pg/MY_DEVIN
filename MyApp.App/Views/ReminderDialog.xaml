<Window x:Class="MyApp.App.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Reminder" Height="620" Width="480"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Title:" FontWeight="Bold"/>
                <TextBox x:Name="TitleTextBox" MaxLength="200"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Reminder Date:" FontWeight="Bold"/>
                <DatePicker x:Name="ReminderDatePicker" Margin="0,0,0,15"/>

                <TextBlock Text="Reminder Type:" FontWeight="Bold"/>
                <ComboBox x:Name="ReminderTypeComboBox" Margin="0,0,0,15"/>

                <TextBlock Text="Related Entity:" FontWeight="Bold"/>
                <TextBox x:Name="RelatedEntityTextBox" MaxLength="100"
                         Text="{Binding RelatedEntity, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Related ID:" FontWeight="Bold"/>
                <TextBox x:Name="RelatedIdTextBox" MaxLength="9"
                         PreviewTextInput="DigitsOnly_PreviewTextInput"/>

                <TextBlock Text="Notes:" FontWeight="Bold"/>
                <TextBox x:Name="NotesTextBox" MaxLength="1000"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                <CheckBox x:Name="IsCompletedCheckBox" IsChecked="{Binding IsCompleted}" Content="Completed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="80" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
