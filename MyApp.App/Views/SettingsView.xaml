<UserControl x:Class="MyApp.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:MyApp.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
    </UserControl.Resources>
    <Grid Background="#1E1E1E">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Header -->
                <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,20"/>

                <!-- General Settings -->
                <Border Background="#2D2D2D" BorderBrush="#3E3E42" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="General Settings" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Currency:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="5"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Currency Symbol:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="5"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Date Format:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="5"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start Page:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedItem="{Binding StartPage}" 
                                      Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="5">
                                <ComboBoxItem Content="Dashboard"/>
                                <ComboBoxItem Content="Accounts"/>
                                <ComboBoxItem Content="Transactions"/>
                                <ComboBoxItem Content="Categories"/>
                                <ComboBoxItem Content="Vehicle"/>
                                <ComboBoxItem Content="Maintenance"/>
                                <ComboBoxItem Content="Reminders"/>
                            </ComboBox>
                        </Grid>

                        <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Background="#3D3D3D" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="10,5"/>
                    </StackPanel>
                </Border>

                <!-- Data Settings -->
                <Border Background="#2D2D2D" BorderBrush="#3E3E42" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Data Settings" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Database Location:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Statistics.DatabaseLocation}" Foreground="#B0B0B0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Database Size:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Foreground="#B0B0B0" VerticalAlignment="Center">
                                <Run Text="{Binding Statistics.DatabaseSize, Converter={StaticResource BytesToSizeConverter}}"/>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Number of Accounts:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Statistics.AccountCount}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Number of Transactions:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Statistics.TransactionCount}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Number of Vehicles:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Statistics.VehicleCount}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Number of Maintenance Records:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Statistics.MaintenanceRecordCount}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Number of Reminders:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Statistics.ReminderCount}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Button Content="Refresh Statistics" Command="{Binding RefreshStatisticsCommand}" Width="140" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Background="#3D3D3D" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="10,5"/>
                    </StackPanel>
                </Border>

                <!-- Backup &amp; Restore -->
                <Border Background="#2D2D2D" BorderBrush="#3E3E42" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Backup &amp; Restore" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Last Backup:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastBackupInfo.Message}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Last Backup Date:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastBackupInfo.BackupDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Backup Database" Command="{Binding BackupCommand}" Width="140" Margin="0,0,10,0"
                                    Background="#3D3D3D" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="10,5"/>
                            <Button Content="Restore Database" Command="{Binding RestoreCommand}" Width="140"
                                    Background="#3D3D3D" Foreground="#E0E0E0" BorderBrush="#3E3E42" Padding="10,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Application Information -->
                <Border Background="#2D2D2D" BorderBrush="#3E3E42" BorderThickness="1" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Application Information" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Application:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="MyApp" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Version:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="1.0" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Database:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="SQLite" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>